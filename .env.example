# Local application environment. Replace with values from `supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
# Server-only. Never expose this value through NEXT_PUBLIC_* variables or browser code.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
# Trusted, canonical application origin used for authentication redirects.
APP_URL=http://127.0.0.1:3000

# Optional: deployed browser E2E is allowed only against Staging.
# PLAYWRIGHT_BASE_URL=https://crm-staging.example.org
# PLAYWRIGHT_TARGET_ENV=staging
